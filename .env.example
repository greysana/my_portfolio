# Public URL of the deployed site (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: shared rate-limit store. Without these, limits are kept in memory
# per server instance (fine for one VPS/container, weak on serverless).
# Free tier at https://upstash.com works well.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: set to "true" ONLY if you deploy behind a trusted reverse proxy/CDN
# (Vercel, Cloudflare, nginx) so the client IP can be read from forwarded headers.
TRUST_PROXY=true
